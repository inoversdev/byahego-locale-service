# API origin the globe page calls (build time: change it, then run `npm run web:build` again).
# Leave empty when the API serves the page itself (npm start) or when using `npm run web:dev` (proxied).
# When the page is hosted separately (nginx / static host), set it to a URL the *browser* can reach, and add this
# page's origin to CORS_ORIGINS in the service's .env.
#   VITE_API_BASE=https://locale-api.byahego.site
#   VITE_API_BASE=http://203.0.113.10:8083
VITE_API_BASE=
