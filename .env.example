APP_ENV=development
PORT=8082

APP_NAME=ByaheGo Locale Service
API_PREFIX=/api/v1

DB_HOST=localhost
DB_PORT=3306
DB_USER=localization_service
DB_PASSWORD=your_password
DB_NAME=byahego_localization

# Browser origins allowed to call this API (comma-separated). Needed only when the globe page is hosted
# separately, e.g. CORS_ORIGINS=https://locale-web.example.com,http://locale-web.example.com:8084
CORS_ORIGINS=
